# ── RenLocalizer .gitignore ──────────────────────────────────────────

# RenLocalizer config
opencode.jsonc

# Session logs
session-*.md
.omo/

# Backup files
*.bak

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]
*.pyo
*.egg-info/
*.egg
.eggs/
.env
venv/
env/
.venv/

# ── Build & Distribution ──────────────────────────────────────────────
dist/
# Ignore Python/PyInstaller build artifacts but keep the build/linux AppImage files
# (macOS has no script: the spec's BUNDLE block makes the .app, see release.yml)
build/bdist.*
build/lib
build_log.txt
*.spec
!RenLocalizer.spec
*.log

# ── IDE & Editor ──────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
*~

# ── OS Files ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── User Data ─────────────────────────────────────────────────────────
config.json
glossary.json

# ── Development ───────────────────────────────────────────────────────
# Internal docs (not needed in repo)
AGENTS.md
BUILD.md
COMPREHENSIVE_ANALYSIS_TR.md
EXTRACTION_COVERAGE_FINAL_REPORT.md

# Debug & temp
debug_out.txt
test_qml_debug.py

# Analysis scripts
analyze_mommysquest.py

# Old drafts
eski_forum.txt
forum.md
index.html
opencode.exe

# Test game files (large binaries)
*impl/
*_impl/

# Temp directories
tmp/
temp/
*.tmp

# ── Docs (external) ──────────────────────────────────────────────────
# Old version backup — kept for reference
# Old-Version/ is intentionally tracked

# ── Ren'Py SDK reference (not part of the project) ───────────────────
# Full Ren'Py engine source + sample games, kept locally for lexer/parser
# reference. 87 MB + copyrighted assets — never commit.
renpy/
